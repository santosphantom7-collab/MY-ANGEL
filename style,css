*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{

height:100vh;
overflow:hidden;

display:flex;
justify-content:center;
align-items:center;

font-family:'Poppins',sans-serif;

background:
radial-gradient(circle at top,#18213d,#070b18 60%,#02040b);

color:white;
}

#stars{

position:fixed;
left:0;
top:0;

width:100%;
height:100%;

overflow:hidden;
z-index:1;

}

.star{

position:absolute;

width:2px;
height:2px;

background:white;

border-radius:50%;

animation:twinkle 2s infinite alternate;
}

@keyframes twinkle{

from{

opacity:.2;
transform:scale(.7);

}

to{

opacity:1;
transform:scale(1.4);

}

}

.moon{

position:absolute;

right:8%;
top:10%;

width:180px;
height:180px;

border-radius:50%;

background:#f9f6d2;

box-shadow:

0 0 30px #fff,
0 0 60px rgba(255,255,255,.5),
0 0 120px rgba(255,255,255,.2);

z-index:2;

}

.overlay{

position:relative;
z-index:5;

text-align:center;

max-width:700px;

padding:30px;

}

.small-title{

letter-spacing:5px;

font-weight:300;

margin-bottom:20px;

opacity:.8;

}

h1{

font-family:'Cormorant Garamond',serif;

font-size:70px;

min-height:90px;

margin-bottom:20px;

}

.subtitle{

font-size:20px;

opacity:.8;

margin-bottom:40px;

}

button{

padding:18px 45px;

border:none;

border-radius:50px;

font-size:18px;

cursor:pointer;

background:white;

color:#111;

transition:.3s;

}

button:hover{

transform:translateY(-5px);

box-shadow:0 0 25px white;

}

@media(max-width:768px){

h1{

font-size:45px;

}

.subtitle{

font-size:16px;

}

.moon{

width:120px;
height:120px;

}

}
