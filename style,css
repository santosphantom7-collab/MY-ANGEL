/* ===========================================
   FOR KIKI ❤️
   STYLE.CSS
=========================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    background:#040814;

    color:white;

    font-family:'Poppins',sans-serif;

    overflow-x:hidden;

}

/* ===============================
BACKGROUND
=============================== */

body::before{

    content:"";

    position:fixed;

    inset:0;

    background:

    radial-gradient(circle at top,#16254b 0%,#09111f 45%,#020409 100%);

    z-index:-5;

}

/* ===============================
STARS
=============================== */

#stars{

    position:fixed;

    inset:0;

    overflow:hidden;

    z-index:-3;

}

.star{

    position:absolute;

    width:2px;

    height:2px;

    background:white;

    border-radius:50%;

    animation:twinkle 3s infinite alternate;

}

.star.big{

    width:4px;

    height:4px;

}

.star.small{

    width:1px;

    height:1px;

}

/* ===============================
SHOOTING STARS
=============================== */

#shooting-stars{

    position:fixed;

    inset:0;

    pointer-events:none;

    overflow:hidden;

    z-index:-2;

}

.shooting-star{

    position:absolute;

    width:160px;

    height:2px;

    background:linear-gradient(to right,
    white,
    rgba(255,255,255,0));

    transform:rotate(-35deg);

    animation:shoot 4s linear forwards;

}

/* ===============================
MOON
=============================== */

.moon{

    position:fixed;

    top:70px;

    right:80px;

    width:170px;

    height:170px;

    border-radius:50%;

    background:#fffbe8;

    box-shadow:

    0 0 20px white,

    0 0 60px rgba(255,255,255,.6),

    0 0 140px rgba(255,255,255,.25);

    z-index:-1;

}

/* ===============================
OVERLAY
=============================== */

.gradient-overlay{

    position:fixed;

    inset:0;

    background:linear-gradient(

        rgba(0,0,0,.10),

        rgba(0,0,0,.20),

        rgba(0,0,0,.45)

    );

    pointer-events:none;

}

/* ===============================
NAVIGATION
=============================== */

nav{

    position:fixed;

    top:0;

    width:100%;

    padding:20px 60px;

    display:flex;

    justify-content:space-between;

    align-items:center;

    backdrop-filter:blur(12px);

    background:rgba(0,0,0,.15);

    z-index:100;

}

.logo{

    font-size:26px;

    font-weight:700;

    letter-spacing:2px;

}

nav ul{

    display:flex;

    gap:35px;

    list-style:none;

}

nav a{

    color:white;

    text-decoration:none;

    transition:.3s;

}

nav a:hover{

    color:#ffd5f7;

}

/* ===============================
INTRO
=============================== */

#intro{

    min-height:100vh;

    display:flex;

    justify-content:center;

    align-items:center;

    text-align:center;

    padding:120px 20px;

}

.hero-content{

    max-width:850px;

}

.small-text{

    letter-spacing:6px;

    text-transform:uppercase;

    opacity:.75;

    margin-bottom:20px;

}

#typewriter{

    font-family:'Cormorant Garamond',serif;

    font-size:78px;

    margin-bottom:25px;

}

.hero-description{

    max-width:700px;

    margin:auto;

    line-height:1.9;

    font-size:20px;

    opacity:.85;

}

#beginJourney{

    margin-top:45px;

    padding:18px 55px;

    border:none;

    border-radius:60px;

    cursor:pointer;

    background:white;

    color:#111;

    font-size:18px;

    transition:.35s;

}

#beginJourney:hover{

    transform:translateY(-6px);

    box-shadow:

    0 0 20px white,

    0 0 50px rgba(255,255,255,.4);

}

.scroll-indicator{

    position:absolute;

    bottom:30px;

    font-size:30px;

    animation:float 2s infinite;

}
